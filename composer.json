{
    "name": "lionser/array-diff",
    "description": "Structural diff of nested arrays in field/old/new format",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Lionser\\ArrayDiff\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lionser\\ArrayDiff\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    }
}
